# psrao-website — build-time variables (Vite). Only VITE_* keys reach the browser.
# Production build = all empty: everything is same-origin on Cloudflare Pages.

# Booking API (/api/available-slots, /api/create-meeting).
# Prod: Cloudflare Pages Functions on the same origin → leave empty.
# Dev:  leave empty and Vite proxies /api → API_PROXY_TARGET (default http://localhost:5000,
#       see vite.config.ts), or run `wrangler pages dev` so the real Functions answer.
VITE_API_BASE_URL=

# Built-in CMS (/api/cms/<collection>, /api/media/<key>, edited at /admin).
# MUST stay empty for production — a non-empty value sends every content fetch to that
# origin and the site silently falls back to its bundled defaults.
# Only set this when running `vite dev` against a deployed site, e.g. https://psrao-consulting.pages.dev
VITE_CMS_URL=
