# PS Rao API server — copy to .env and fill in. (.env is gitignored.)

# Port the API listens on (the website's Vite dev proxy targets this).
PORT=5000

# --- AI features (Insights article summary + text-to-speech) ---
OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- Booking (Google Calendar) ---
# Workspace user whose calendar holds the appointments (impersonated via domain-wide delegation).
CALENDAR_IMPERSONATE_USER=appointments@psrao.co.in
# Service-account credentials. Default: ./service-account-creds.json (gitignored).
# Or point to another path:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-creds.json
# Or provide the raw JSON inline instead of a file:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
